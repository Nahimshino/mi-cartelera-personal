rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer y modificar su propia lista: usuarios/{uid}/mi_lista/{itemId}
    match /usuarios/{userId}/mi_lista/{itemId} {

      function esDueno() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Reglas de negocio validadas también en el servidor.
      function datosValidos(d) {
        return d.keys().hasOnly(['tmdbId', 'tipo', 'titulo', 'anio', 'posterPath', 'estado',
                                 'calificacionPersonal', 'comentario', 'agregadoEn', 'actualizadoEn'])
          && d.keys().hasAll(['tmdbId', 'tipo', 'titulo', 'anio', 'posterPath', 'estado',
                              'calificacionPersonal', 'comentario', 'agregadoEn', 'actualizadoEn'])
          && d.tmdbId is int && d.tmdbId > 0
          && d.tipo in ['movie', 'tv']
          // El id del documento debe ser tipo_tmdbId (evita duplicados).
          && itemId == d.tipo + '_' + string(d.tmdbId)
          && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 300
          && d.anio is string && d.anio.size() <= 4
          && (d.posterPath == null || (d.posterPath is string && d.posterPath.size() <= 200))
          && d.estado in ['por_ver', 'viendo', 'vista']
          && d.comentario is string && d.comentario.size() <= 500
          // Solo se califica (1 a 5) si el estado es "vista".
          && (d.calificacionPersonal == null
              || (d.estado == 'vista' && d.calificacionPersonal is int
                  && d.calificacionPersonal >= 1 && d.calificacionPersonal <= 5))
          && d.actualizadoEn == request.time;
      }

      allow read, delete: if esDueno();

      allow create: if esDueno()
        && datosValidos(request.resource.data)
        && request.resource.data.estado == 'por_ver'
        && request.resource.data.calificacionPersonal == null
        && request.resource.data.agregadoEn == request.time;

      allow update: if esDueno()
        && datosValidos(request.resource.data)
        // La obra y la fecha en que se agregó no pueden cambiar.
        && request.resource.data.diff(resource.data).unchangedKeys()
             .hasAll(['tmdbId', 'tipo', 'titulo', 'anio', 'posterPath', 'agregadoEn']);
    }

    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
